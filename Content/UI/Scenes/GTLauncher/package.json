{
    "name": "antigravity-launcher",
    "version": "1.0.0",
    "description": "Premium GT-Style Game Launcher for Antigravity Nexus",
    "main": "main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron .",
        "start": "vite build && electron .",
        "package": "vite build && electron-builder"
    },
    "build": {
        "appId": "com.antigravity.nexus",
        "productName": "Antigravity Nexus",
        "mac": {
            "target": "dmg",
            "icon": "assets/icon.icns"
        }
    },
    "dependencies": {
        "@splinetool/react-spline": "^4.0.0",
        "@splinetool/runtime": "^1.9.0",
        "framer-motion": "^11.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.0",
        "electron": "^28.0.0",
        "electron-builder": "^24.0.0",
        "vite": "^5.0.0"
    }
}