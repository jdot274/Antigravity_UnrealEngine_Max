{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Antigravity: Dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/shader_overlay/main.py",
            "console": "integratedTerminal",
            "env": {
                "QTWEBENGINE_CHROMIUM_FLAGS": "--transparent-background --enable-gpu-rasterization --ignore-gpu-blocklist"
            },
            "justMyCode": true
        },
        {
            "name": "Antigravity: Build App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/shader_overlay/build_app.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Antigravity: Launcher UI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/shader_overlay/ue_launcher.py",
            "console": "integratedTerminal",
            "env": {
                "QTWEBENGINE_CHROMIUM_FLAGS": "--transparent-background"
            }
        },
        {
            "type": "msedge",
            "name": "Launch Microsoft Edge",
            "request": "launch",
            "runtimeArgs": [
                "--remote-debugging-port=9222"
            ],
            "url": "/Users/joeywalter/.antigravity/extensions/ms-edgedevtools.vscode-edge-devtools-2.1.10-universal/out/startpage/index.html", // Provide your project's url to finish configuring
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "msedge",
            "name": "Launch Microsoft Edge in headless mode",
            "request": "launch",
            "runtimeArgs": [
                "--headless",
                "--remote-debugging-port=9222"
            ],
            "url": "/Users/joeywalter/.antigravity/extensions/ms-edgedevtools.vscode-edge-devtools-2.1.10-universal/out/startpage/index.html", // Provide your project's url to finish configuring
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "vscode-edge-devtools.debug",
            "name": "Open Edge DevTools",
            "request": "attach",
            "url": "/Users/joeywalter/.antigravity/extensions/ms-edgedevtools.vscode-edge-devtools-2.1.10-universal/out/startpage/index.html", // Provide your project's url to finish configuring
            "presentation": {
                "hidden": true
            }
        }
    ],
    "compounds": [
        {
            "name": "Launch Edge Headless and attach DevTools",
            "configurations": [
                "Launch Microsoft Edge in headless mode",
                "Open Edge DevTools"
            ]
        },
        {
            "name": "Launch Edge and attach DevTools",
            "configurations": [
                "Launch Microsoft Edge",
                "Open Edge DevTools"
            ]
        }
    ]
}